In ReferenceObj_Read, look at SEQ_LEN only after a row has been read (libs/align/reference.c).

When TableReader_ReadRow fails (e.g. an external reference that isn't available), the loop
still read the SEQ_LEN cell: a stale value if an earlier reference's row had been read, else
a NULL dereference. Loading a reference that can't be found then crashed instead of failing.
The loop ends on a failed read either way, so this changes nothing else. Upstream:
https://github.com/ncbi/ncbi-vdb/issues/282 and https://github.com/ncbi/ncbi-vdb/pull/283.
Drop this patch once the vendored ncbi-vdb includes it.

diff --git a/libs/align/reference.c b/libs/align/reference.c
index b69d0d0..1a02b96 100644
--- a/libs/align/reference.c
+++ b/libs/align/reference.c
@@ -1025,12 +1025,13 @@ LIB_EXPORT rc_t CC ReferenceObj_Read( const ReferenceObj* cself, INSDC_coord_zer
                         *written += q;
                         offset += q;
                         len -= q;
-                    }
-                    /* SEQ_LEN < MAX_SEQ_LEN is last row unless it is CIRCULAR */
-                    if ( cself->mgr->reader_cols[ ereflst_cn_SEQ_LEN ].base.coord_len[ 0 ] < cself->mgr->max_seq_len )
-                    {
-                        if ( !cself->circular ) { break; }
-                        offset = 0;
+                        /* SEQ_LEN < MAX_SEQ_LEN is last row unless it is CIRCULAR;
+                         * only a row that was read has a SEQ_LEN to look at */
+                        if ( cself->mgr->reader_cols[ ereflst_cn_SEQ_LEN ].base.coord_len[ 0 ] < cself->mgr->max_seq_len )
+                        {
+                            if ( !cself->circular ) { break; }
+                            offset = 0;
+                        }
                     }
                 } while ( rc == 0 && q > 0 && len > 0 );
             }
